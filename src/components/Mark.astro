---
/**
 * UKEMI brand symbol — the original logo artwork (fractured ice/stone crescent, nail, sprout),
 * cut out from its backdrop (see brand-assets/logo/matte.py). Served as responsive WebP.
 */
import { Image } from 'astro:assets';
import symbol from '../assets/brand/ukemi-symbol.png';

interface Props {
  /** Accessible name. Omit for a purely decorative mark. */
  label?: string;
  /** Rendered CSS width in px — used to pick image sizes. */
  width?: number;
  eager?: boolean;
  class?: string;
}

const { label, width = 300, eager = false, class: className } = Astro.props;
---

<Image
  src={symbol}
  alt={label ?? ''}
  width={Math.min(width, symbol.width)}
  densities={[1, 2]}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class:list={['mark', className]}
  aria-hidden={label ? undefined : 'true'}
/>

<style>
  .mark {
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
