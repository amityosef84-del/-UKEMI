---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BoardIllustration from './BoardIllustration.astro';
import Arrow from './Arrow.astro';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const p = product.data;
const cover = p.images[0];
---

<article class="card">
  <a href={`/boards/${product.id}/`} class="card__link">
    <div class="card__visual">
      {
        cover ? (
          <Image src={cover} alt={`${p.name} sadhu board`} widths={[480, 800, 1200]} sizes="(min-width: 900px) 33vw, 100vw" class="card__img" />
        ) : (
          <BoardIllustration cols={p.grid.cols} rows={p.grid.rows} material={p.nail.material} finish={p.finish} class="card__board" />
        )
      }
      <span class="card__level">{p.level}</span>
    </div>
    <div class="card__body">
      <h3 class="card__name">
        {p.name}
        {p.kanji && <span class="card__kanji jp">{p.kanji}</span>}
      </h3>
      <p class="card__tagline">{p.tagline}</p>
      <p class="card__spec">
        <span>{p.nail.material} nails</span>
        <span aria-hidden="true">·</span>
        <span>{p.nail.spacing} spacing</span>
      </p>
      <span class="card__more">Discover <Arrow /></span>
    </div>
  </a>
</article>

<style>
  .card {
    position: relative;
  }

  .card__link {
    display: grid;
    gap: 1.5rem;
  }

  .card__visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 4.4;
    padding: 12% 10%;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(80% 60% at 50% 45%, color-mix(in srgb, var(--ice-deep) 55%, transparent), transparent 70%),
      var(--surface);
    overflow: hidden;
    transition:
      border-color var(--dur) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .card__visual :global(.card__board) {
    width: 92%;
  }

  .card__link:hover .card__visual {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .card__link:hover .card__img {
    transform: scale(1.04);
  }

  .card__link:hover :global(.board--tilt .board__svg) {
    transform: rotateX(46deg) rotateZ(-18deg) translateY(-6px);
  }

  .card__level {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--charcoal) 55%, transparent);
    font-family: var(--font-display);
    font-stretch: var(--wordmark-stretch);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--frost);
  }

  .card__body {
    display: grid;
    gap: 0.5rem;
  }

  .card__name {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--fs-xl);
  }

  .card__kanji {
    font-size: 0.55em;
    color: var(--ink-soft);
  }

  .card__tagline {
    color: var(--ink-soft);
  }

  .card__spec {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--highlight);
  }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-stretch: var(--wordmark-stretch);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__more :global(.btn__arrow) {
    width: 1rem;
    transition: transform var(--dur) var(--ease-out);
  }

  .card__link:hover .card__more :global(.btn__arrow) {
    transform: translateX(5px);
  }
</style>
