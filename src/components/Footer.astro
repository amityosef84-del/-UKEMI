---
import Mark from './Mark.astro';
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer theme-dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Mark class="footer__mark" width={64} />
        <p class="footer__tag">{site.tagline}</p>
      </div>

      <nav class="footer__col" aria-label="Footer">
        <p class="footer__title">Explore</p>
        <ul role="list">
          {nav.map((item) => <li><a class="link-soft" href={item.href}>{item.label}</a></li>)}
          <li><a class="link-soft" href="/contact/">Contact</a></li>
        </ul>
      </nav>

      <div class="footer__col">
        <p class="footer__title">Follow</p>
        <ul role="list">
          {site.social.map((s) => <li><a class="link-soft" href={s.href} rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>

      <div class="footer__col">
        <p class="footer__title">Write to us</p>
        <ul role="list">
          <li><a class="link-soft" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="link-soft" href="/contact/?type=wholesale">Wholesale &amp; retail</a></li>
        </ul>
      </div>
    </div>

    <p class="footer__word" aria-hidden="true" data-reveal="up">UKEMI</p>

    <div class="footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="footer__disclaimer">
        UKEMI boards are wellness tools, not medical devices. Consult a medical professional before starting a new practice.
      </p>
      <ul role="list" class="footer__legal">
        <li><a class="link-soft" href="/privacy/">Privacy</a></li>
        <li><a class="link-soft" href="/terms/">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(4rem, 3rem + 5vw, 7rem) 2rem;
    background: var(--bg);
    color: var(--ink);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .footer__top {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .footer__top {
      grid-template-columns: 2fr 1fr 1fr 1.3fr;
    }
  }

  .footer__brand :global(.footer__mark) {
    width: 64px;
  }

  .footer__tag {
    margin-top: 1.25rem;
    color: var(--ink-soft);
    letter-spacing: 0.06em;
  }

  .footer__title {
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-stretch: var(--wordmark-stretch);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--highlight);
  }

  .footer__col ul {
    display: grid;
    gap: 0.55rem;
  }

  .link-soft {
    color: var(--ink-soft);
    transition: color var(--dur-fast);
  }

  .link-soft:hover {
    color: var(--ink);
  }

  .footer__word {
    margin-block: clamp(3rem, 2rem + 5vw, 6rem) 1.5rem;
    font-family: var(--font-display);
    font-stretch: var(--wordmark-stretch);
    font-weight: 600;
    font-size: clamp(3.5rem, 19vw, 19rem);
    line-height: 0.8;
    letter-spacing: 0.12em;
    margin-right: -0.12em;
    text-align: center;
    background: linear-gradient(180deg, color-mix(in srgb, var(--frost) 16%, transparent), transparent 92%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
  }

  .footer__bottom {
    display: grid;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .footer__bottom {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 2rem;
    }
  }

  .footer__disclaimer {
    max-width: 60ch;
  }

  .footer__legal {
    display: flex;
    gap: 1.5rem;
  }
</style>
