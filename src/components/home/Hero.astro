---
import { Image, getImage } from 'astro:assets';
import Mark from '../Mark.astro';
import NailField from '../NailField.astro';
import { site } from '../../data/site';
import symbol from '../../assets/brand/ukemi-symbol.png';
import wordmark from '../../assets/brand/ukemi-wordmark.png';

// Small WebP of the symbol, used as the mask for the light sweep.
const shineMask = await getImage({ src: symbol, width: 300, format: 'webp' });
---

<section class="hero theme-dark" data-hero>
  <NailField class="hero__field" />
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__stage container">
    <div class="hero__emblem">
      <Mark class="hero__mark" width={300} eager />
      <span
        class="hero__shine"
        style={`-webkit-mask-image: url(${shineMask.src}); mask-image: url(${shineMask.src})`}
        aria-hidden="true"></span>
    </div>
    <h1 class="hero__title">
      <Image src={wordmark} alt="UKEMI" width={560} densities={[1, 2]} loading="eager" class="hero__word" />
      <span class="visually-hidden"> — sadhu boards</span>
    </h1>
    <p class="hero__tagline">{site.tagline}</p>
  </div>

  <div class="hero__foot container">
    <p class="hero__kanji"><span class="jp">{site.kanji}</span> The art of falling — and rising again.</p>
    <a href="#manifesto" class="hero__scroll">Scroll <span aria-hidden="true"></span></a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    padding-top: var(--header-h);
    background: var(--bg);
    overflow: hidden;
    isolation: isolate;
  }

  .hero :global(.hero__field) {
    z-index: -1;
    -webkit-mask-image: radial-gradient(ellipse 70% 65% at 50% 45%, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse 70% 65% at 50% 45%, #000 20%, transparent 78%);
  }

  .hero__glow {
    position: absolute;
    left: 50%;
    top: 42%;
    z-index: -1;
    width: min(90vw, 900px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, color-mix(in srgb, var(--ice-deep) 70%, transparent) 0%, transparent 62%);
    filter: blur(20px);
    opacity: 0.85;
  }

  .hero__stage {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    text-align: center;
    will-change: transform, opacity;
  }

  .hero__emblem {
    position: relative;
    width: clamp(150px, 21vw, 280px);
  }

  .hero :global(.hero__mark) {
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.6));
  }

  /* A band of light that crosses the metal once the emblem lands — clipped to the logo's shape */
  .hero__shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 38%, rgba(235, 244, 250, 0.75) 50%, transparent 62%) 160% 0 / 260% 100% no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .hero__title {
    margin-top: clamp(0.75rem, 2vw, 1.5rem);
    line-height: 0;
  }

  .hero :global(.hero__word) {
    width: clamp(220px, 40vw, 560px);
    height: auto;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.5));
  }

  .hero__tagline {
    font-size: var(--fs-md);
    font-weight: 300;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
  }

  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }

  .hero__kanji .jp {
    margin-right: 0.75em;
    color: var(--ink);
  }

  .hero__scroll {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-stretch: var(--wordmark-stretch);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .hero__scroll span {
    position: relative;
    width: 1px;
    height: 54px;
    overflow: hidden;
    background: var(--line);
  }

  .hero__scroll span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--growth);
    animation: scroll-cue 2.2s var(--ease-in-out) infinite;
  }

  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  @media (max-width: 640px) {
    .hero__kanji {
      max-width: 22ch;
    }
  }

  /* Hidden until the intro timeline reveals them */
  :global(html.motion) .hero__emblem,
  :global(html.motion) .hero :global(.hero__word),
  :global(html.motion) .hero__tagline,
  :global(html.motion) .hero__foot {
    visibility: hidden;
  }
</style>
