---
import { testimonials } from '../../data/site';
---

<section class="voices section theme-ice">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">Voices</span>
      <h2 data-split>Stronger, in their words.</h2>
    </header>

    <ul class="voices__grid" role="list" data-stagger>
      {
        testimonials.map((t) => (
          <li class="voice">
            <svg class="voice__mark" viewBox="0 0 32 24" aria-hidden="true">
              <path d="M0 24V13.6C0 5.9 4.4 1.3 11.2 0l1.3 3.2C8.6 4.6 6.6 7.4 6.4 11h5.4v13H0Zm19.2 0V13.6C19.2 5.9 23.6 1.3 30.4 0l1.3 3.2c-3.9 1.4-5.9 4.2-6.1 7.8H31v13H19.2Z" />
            </svg>
            <blockquote>
              <p>{t.quote}</p>
            </blockquote>
            <p class="voice__who">
              {t.name}
              <span>{t.place}</span>
            </p>
          </li>
        ))
      }
    </ul>
    <p class="voices__note">Sample quotes for layout — replace with real, approved customer testimonials before launch.</p>
  </div>
</section>

<style>
  .voices__grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 860px) {
    .voices__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .voice {
    display: grid;
    align-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--charcoal) 22%, transparent);
  }

  .voice__mark {
    width: 28px;
    fill: var(--growth);
  }

  .voice blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-size: var(--fs-lg);
    line-height: 1.3;
  }

  .voice__who {
    display: grid;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .voice__who span {
    font-weight: 400;
    color: var(--ink-soft);
  }

  .voices__note {
    margin-top: 2rem;
    font-size: var(--fs-xs);
    color: var(--ink-soft);
    opacity: 0.8;
  }
</style>
