---
import Mark from './Mark.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" class:list={['logo', className]} aria-label="UKEMI — home">
  <Mark class="logo__mark" width={32} eager />
  <span class="logo__word" aria-hidden="true">UKEMI</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
  }

  .logo :global(.logo__mark) {
    width: 30px;
    transition: transform var(--dur) var(--ease-out);
  }

  .logo:hover :global(.logo__mark) {
    transform: rotate(-8deg);
  }

  .logo__word {
    font-family: var(--font-display);
    font-stretch: var(--wordmark-stretch);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: var(--tracking-wider);
    margin-right: calc(var(--tracking-wider) * -1);
    background: linear-gradient(180deg, #f1f2f3 0%, var(--frost) 45%, var(--stone) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
