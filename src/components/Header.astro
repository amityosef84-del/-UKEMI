---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="header" data-header>
  <div class="header__bar container">
    <Logo />

    <nav class="header__nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="header__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contact/" class="btn header__cta">Contact <Arrow /></a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="header__burger" aria-hidden="true"></span>
    </button>
  </div>

  <div class="menu" id="menu" data-menu>
    <nav class="menu__nav container" aria-label="Mobile">
      <ul role="list">
        {
          [...nav, { label: 'Contact', href: '/contact/' }].map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="menu__num">0{i + 1}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="menu__tag">{site.tagline}</p>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      transform var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .header.is-scrolled {
    background: color-mix(in srgb, var(--charcoal) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-color: var(--line);
  }

  /* backdrop-filter would trap the fixed menu inside the bar — drop it while open */
  .header.is-open {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: transparent;
  }

  .header.is-hidden:not(.is-open) {
    transform: translateY(-100%);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2.75rem);
  }

  .header__link {
    position: relative;
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    transition: color var(--dur-fast);
  }

  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }

  .header__link:hover,
  .header__link[aria-current='page'] {
    color: var(--ink);
  }

  .header__link:hover::after,
  .header__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__cta {
    min-height: 42px;
    padding: 0.7em 1.3em;
  }

  .header__toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
  }

  .header__burger,
  .header__burger::before {
    position: absolute;
    left: 50%;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--dur) var(--ease-out);
  }

  .header__burger {
    top: calc(50% - 3px);
    transform: translateX(-50%);
  }

  .header__burger::before {
    content: '';
    top: 6px;
    transform: translateX(-50%);
  }

  .is-open .header__burger {
    transform: translateX(-50%) translateY(3px) rotate(45deg);
  }

  .is-open .header__burger::before {
    transform: translateX(-50%) translateY(-6px) rotate(-90deg);
  }

  /* ---- Mobile menu ---- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    align-items: center;
    background: var(--charcoal);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path var(--dur-slow) var(--ease-in-out),
      visibility 0s linear var(--dur-slow);
  }

  .is-open .menu {
    clip-path: inset(0);
    visibility: visible;
    transition:
      clip-path var(--dur-slow) var(--ease-in-out),
      visibility 0s;
  }

  .menu__nav ul {
    display: grid;
    gap: 0.5rem;
  }

  .menu__nav li {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .is-open .menu__nav li {
    opacity: 1;
    transform: none;
    transition-delay: calc(240ms + var(--i) * 70ms);
  }

  .menu__nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .menu__nav a[aria-current='page'] {
    color: var(--accent);
  }

  .menu__num {
    font-size: var(--fs-xs);
    color: var(--highlight);
    letter-spacing: var(--tracking-wide);
  }

  .menu__tag {
    margin-top: 3rem;
    color: var(--ink-soft);
    letter-spacing: 0.08em;
  }

  @media (max-width: 860px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__toggle {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header && toggle) {
    // Solid background after leaving the top; hide while scrolling down, show on scroll up.
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle('is-scrolled', y > 24);
      header.classList.toggle('is-hidden', y > lastY && y > 320);
      lastY = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      const lenis = window.ukemi?.lenis;
      if (lenis) open ? lenis.stop() : lenis.start();
    };

    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    header.querySelectorAll('[data-menu] a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }
</script>
